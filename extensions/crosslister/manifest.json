{
  "manifest_version": 3,
  "name": "Fashionistas Crosslister",
  "short_name": "Crosslister",
  "version": "1.0.0",
  "description": "Fills your Fashionistas listing into Depop, eBay, Poshmark, Mercari, Vinted and Grailed. You check it and press Post yourself.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Fashionistas Crosslister",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs"
  ],
  "host_permissions": [
    "https://fashionistas-api.fashionistas1979.workers.dev/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://fashionistas.ai/*",
        "https://www.fashionistas.ai/*",
        "https://fashionistas-ai.pages.dev/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.depop.com/*",
        "https://www.ebay.com/*",
        "https://poshmark.com/*",
        "https://www.mercari.com/*",
        "https://www.vinted.com/*",
        "https://www.grailed.com/*"
      ],
      "js": [
        "fill.js",
        "filler.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}